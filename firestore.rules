rules_version = '2';
// Правила безпеки бази даних. Вставте цей текст у Firebase Console →
// Firestore Database → Rules і натисніть Publish.
// Пошта адміністратора має збігатися з adminEmails у js/config.js.
//
// Ролі:
//   адміністратор — пошта зі списку нижче; має всі повноваження;
//   вчитель       — профіль users/{uid} з role: 'teacher'; бачить і змінює лише свої предмети
//                   (поле subjects) та учнів своїх класів (поле classes);
//   учень         — профіль users/{uid} з role: 'student'.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email in ['teacher.kolo.clubs@gmail.com'];
    }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // Підтверджений і не вимкнений вчитель
    function isTeacher() {
      return hasProfile() && me().role == 'teacher'
        && me().get('pending', false) == false && me().get('disabled', false) == false;
    }
    function teachesClass(c) { return isTeacher() && c in me().get('classes', []); }
    function teachesCourse(id) { return isTeacher() && id in me().get('subjects', []); }
    function isStudent() { return hasProfile() && me().role == 'student'; }

    match /users/{uid} {
      // свій профіль; адміністратор — усі; вчитель — учнів своїх класів
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid)
        || teachesClass(resource.data.get('cls', -1));

      // адміністратор створює будь-кого; вчитель — учнів лише у своїх класах
      allow create: if isAdmin()
        || (request.resource.data.role == 'student' && teachesClass(request.resource.data.cls))
        // самостійна заявка вчителя: лише для себе, без предметів, очікує підтвердження
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == 'teacher'
            && request.resource.data.pending == true
            && request.resource.data.subjects.size() == 0
            && request.resource.data.classes.size() == 0
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.keys().hasOnly(['role', 'pending', 'name', 'email', 'subjects', 'classes', 'requested', 'note', 'createdAt']));

      // вчитель може змінювати ім’я учня свого класу, але не логін, пароль чи роль
      allow update: if isAdmin()
        || (resource.data.role == 'student' && teachesClass(resource.data.cls)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));

      // видаляє лише адміністратор; заявник може відкликати власну заявку
      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == uid && resource.data.role == 'teacher' && resource.data.get('pending', false) == true);
    }

    // Налаштування сайту (список класів і предметів): читають усі, хто увійшов; змінює адміністратор
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Результати тестів: учень додає лише свої і бачить лише свої;
    // адміністратор бачить і видаляє всі; вчитель — лише зі своїх предметів
    match /results/{id} {
      allow read: if isAdmin()
        || teachesCourse(resource.data.course)
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 12;
      // ручне зарахування: вчитель свого предмета (або адміністратор) вносить оцінку за учня
      allow create: if (isAdmin() || teachesCourse(request.resource.data.course))
        && request.resource.data.manual == true
        && request.resource.data.by == request.auth.uid
        && request.resource.data.passed == true
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 12;
      allow update: if false;
      allow delete: if isAdmin() || teachesCourse(resource.data.course);
    }
  
    // Чат учня з вчителем. Кожне повідомлення належить до розмови «учень + предмет».
    // Учень бачить і пише лише у своїх розмовах і лише з предметів свого класу;
    // вчитель — у розмовах своїх предметів; адміністратор — усі.
    match /messages/{id} {
      // Особисті повідомлення: uid — учень-співрозмовник.
      // Групові (вчитель — клас): grp == true, gcls — клас, readBy — хто прочитав.
      // текст або скріншот (стиснений JPEG у полі img, до ~700 КБ)
      function textOk(d) {
        return d.text is string && d.text.size() <= 2000
          && (d.text.size() > 0 || (d.get('img', '') is string && d.get('img', '').size() > 0))
          && (!('img' in d) || (d.img is string && d.img.size() < 720000));
      }
      // листування вчителя з адміністратором: adm == true, tuid — вчитель
      function isAdm(d) { return d.get('adm', false) == true; }
      function isGroup(d) { return d.get('grp', false) == true; }
      function staffOf(c) { return isAdmin() || teachesCourse(c); }

      allow read: if (isAdm(resource.data) && (isAdmin() || resource.data.tuid == request.auth.uid))
        || staffOf(resource.data.course)
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (isStudent() && isGroup(resource.data) && resource.data.gcls == me().cls);

      allow create: if request.resource.data.from == request.auth.uid
        && textOk(request.resource.data)
        && ((isAdm(request.resource.data) && request.resource.data.read == false
              && ((isTeacher() && request.resource.data.role == 't' && request.resource.data.tuid == request.auth.uid)
                || (isAdmin() && request.resource.data.role == 'a')))
          || (!isAdm(request.resource.data) && !isGroup(request.resource.data)
              && request.resource.data.read == false
              && ((isStudent() && request.resource.data.role == 's'
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.cls == me().cls)
                || (staffOf(request.resource.data.course) && request.resource.data.role == 't')))
          || (isGroup(request.resource.data)
              && request.resource.data.readBy == [request.auth.uid]
              && ((isStudent() && request.resource.data.role == 's'
                    && request.resource.data.gcls == me().cls
                    && request.resource.data.cls == me().cls)
                || (staffOf(request.resource.data.course) && request.resource.data.role == 't'))));

      allow update: if
        // «прочитано» в листуванні з адміністратором
        (isAdm(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && ((isAdmin() && resource.data.role == 't') || (resource.data.tuid == request.auth.uid && resource.data.role == 'a')))
        ||
        // «прочитано» в особистій розмові ставить лише співрозмовник
        (!isAdm(resource.data) && !isGroup(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && ((signedIn() && resource.data.uid == request.auth.uid && resource.data.role == 't')
            || (staffOf(resource.data.course) && resource.data.role == 's')))
        // «прочитано» в груповому чаті: учасник додає себе до readBy
        || (isGroup(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.size() == resource.data.readBy.size() + 1
          && request.resource.data.readBy.hasAll([request.auth.uid])
          && (staffOf(resource.data.course) || (isStudent() && resource.data.gcls == me().cls)))
        // редагувати текст може лише автор повідомлення
        || (signedIn() && resource.data.from == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedMs'])
          && textOk(request.resource.data));

      // видаляти повідомлення можуть лише вчитель предмета та адміністратор
      allow delete: if staffOf(resource.data.course)
        || (isAdm(resource.data) && (isAdmin() || resource.data.from == request.auth.uid));
    }
  }
}
